rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidBreakSession(data) {
      return data.keys().hasAll(['name', 'badgeId', 'initials', 'gate', 'zone', 'sessionType', 'timeOut', 'limitMinutes', 'supervisor', 'extension', 'status', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() <= 100
        && data.badgeId is string && data.badgeId.size() <= 20
        && data.initials is string && data.initials.size() <= 3
        && data.gate is string && data.gate.size() <= 50
        && data.zone is string && data.zone.size() <= 50
        && data.sessionType is string && data.sessionType.size() <= 50
        && data.timeOut is timestamp
        && data.limitMinutes is number
        && data.supervisor is string && data.supervisor.size() <= 100
        && data.extension is string && data.extension.size() <= 20
        && data.status in ['Active', 'Completed', 'Force Resolved']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        // Optional fields
        && (data.get('timeIn', null) == null || data.timeIn is timestamp)
        && (data.get('resolveReason', null) == null || (data.resolveReason is string && data.resolveReason.size() <= 100))
        && (data.get('resolveNote', null) == null || (data.resolveNote is string && data.resolveNote.size() <= 500));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /break_sessions/{sessionId} {
      allow get: if isSignedIn() && isValidId(sessionId);
      // For dashboard, we allow list if signed in, but we must enforce a constraint.
      // We will require the query to filter by status or just check if they are signed in,
      // but the strict rules state: "allow list MUST explicitly evaluate existing() or resource.data".
      // Since it's a global dashboard, we can require `resource.data.status in ['Active', 'Completed', 'Force Resolved']` 
      // just to fulfill the rule structure without limiting the data, ensuring the query must include status.
      allow list: if isSignedIn() && resource.data.status in ['Active', 'Completed', 'Force Resolved'];
      
      allow create: if isSignedIn() && isValidId(sessionId)
                    && isValidBreakSession(incoming())
                    && incoming().createdAt == request.time
                    && incoming().updatedAt == request.time
                    && incoming().status == 'Active';
                    
      allow update: if isSignedIn() && isValidId(sessionId)
                    && isValidBreakSession(incoming())
                    && incoming().createdAt == existing().createdAt
                    && incoming().updatedAt == request.time
                    && (
                      // Action: Resolve normally (scan in)
                      (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'timeIn', 'updatedAt'])
                       && incoming().status == 'Completed'
                       && existing().status == 'Active')
                      ||
                      // Action: Force Resolve
                      (incoming().diff(existing()).affectedKeys().hasOnly(['status', 'timeIn', 'resolveReason', 'resolveNote', 'updatedAt'])
                       && incoming().status == 'Force Resolved'
                       && existing().status == 'Active')
                    );
    }
  }
}
